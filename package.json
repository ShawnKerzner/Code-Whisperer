{
  "name": "codewhisperer",
  "displayName": "CodeWhisperer",
  "description": "Plain-English error explanations",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "codewhisperer.runFile",
        "title": "CodeWhisperer: Run File"
      },
      {
        "command": "codewhisperer.setApiKey",
        "title": "CodeWhisperer: Set API Key"
      }
    ],
    "configuration": {
      "title": "CodeWhisperer",
      "properties": {
        "codewhisperer.model": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "Claude model used to explain errors."
        },
        "codewhisperer.maxTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 256,
          "description": "Maximum length of Claude's response, in tokens."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}